# Database Credentials for Docker / Podman Compose
DB_ROOT_PASSWORD=your_root_password_here
DB_NAME=smart_todo
DB_USER=smart_todo_user
DB_PASSWORD=your_user_password_here
DB_PORT=3306

# Database Connection URL (Prisma)
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}"

# NestJS Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL="http://localhost:4200"

# JWT Secrets
JWT_ACCESS_SECRET="generate-a-secure-random-access-secret"
JWT_REFRESH_SECRET="generate-a-secure-random-refresh-secret"
