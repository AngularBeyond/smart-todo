generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Theme {
  light
  dark
}

model User {
  id             String         @id @default(cuid())
  name           String         @db.VarChar(50)
  lastName       String         @map("last_name") @db.VarChar(50)
  email          String         @unique @db.VarChar(255)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  preferredTheme Theme          @default(light) @map("preferred_theme")
  lastLoginAt    DateTime       @default(now()) @map("last_login_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  todoLists      TodoList[]
  todos          TodoItem[]
  refreshTokens  RefreshToken[]

  // Optimizes the daily 90-day inactivity cleanup cron job
  @@index([lastLoginAt], map: "idx_users_last_login_at")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model TodoList {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  name      String     @db.VarChar(100)
  isStarred Boolean    @default(false) @map("is_starred")
  order     Float      @default(0) @db.Double
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos     TodoItem[]

  // Optimizes fetching Starred lists (isStarred DESC, updatedAt DESC) and Unstarred lists (isStarred DESC, order ASC)
  @@index([userId, isStarred, order], map: "idx_todo_lists_user_starred_order")
  @@index([userId, isStarred, updatedAt], map: "idx_todo_lists_user_starred_updated")
  @@map("todo_lists")
}

model TodoItem {
  id          String   @id @default(cuid())
  listId      String   @map("list_id")
  userId      String   @map("user_id")
  text        String   @db.VarChar(500)
  isCompleted Boolean  @default(false) @map("is_completed")
  order       Float    @default(0) @db.Double
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  list        TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optimizes 20-item cursor pagination for Active Todos (ORDER BY order ASC, id ASC)
  @@index([listId, isCompleted, order, id], map: "idx_todos_active_pagination")
  // Optimizes 20-item cursor pagination for Completed Todos (ORDER BY updatedAt DESC, id DESC)
  @@index([listId, isCompleted, updatedAt, id], map: "idx_todos_completed_pagination")
  // Optimizes tenant ownership lookups
  @@index([userId, listId], map: "idx_todos_user_list")
  @@map("todo_items")
}
