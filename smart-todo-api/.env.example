# Database Connection URL for Prisma ORM
DATABASE_URL="mysql://smart_todo_user:smart_todo_pass@localhost:3306/smart_todo"

# NestJS Server Configuration
PORT=3000
NODE_ENV=development

# Frontend Application Origin for CORS
FRONTEND_URL="http://localhost:4200"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="generate-a-secure-random-access-secret"
JWT_REFRESH_SECRET="generate-a-secure-random-refresh-secret"
