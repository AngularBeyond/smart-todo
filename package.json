{
  "name": "smart-todo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Smart TODO Application Monorepo",
  "scripts": {
    "db:up": "podman-compose up -d",
    "db:down": "podman-compose down",
    "db:status": "podman-compose ps",
    "db:e2e:up": "podman-compose -p smart-todo-e2e -f tests/docker-compose.e2e.yml --env-file tests/.env.e2e up -d",
    "db:e2e:down": "podman-compose -p smart-todo-e2e -f tests/docker-compose.e2e.yml down",
    "api": "pnpm --prefix smart-todo-api start:dev",
    "api:build": "pnpm --prefix smart-todo-api build",
    "api:test": "pnpm --prefix smart-todo-api test",
    "api:lint": "pnpm --prefix smart-todo-api lint",
    "web": "pnpm --prefix smart-todo start",
    "web:tunnel": "pnpm --prefix smart-todo start:tunnel",
    "web:build": "pnpm --prefix smart-todo build",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:e2e:ui": "playwright test -c tests/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6"
  }
}
